# aplicacao
PAYMENT_APP_NAME=payment-service
PAYMENT_DEFAULT_PROFILE=local
PAYMENT_LOG_LEVEL=DEBUG
PAYMENT_OPENAPI_CACHE_DISABLED=true

# banco relacional (externo ao cluster)
PAYMENT_DB_URL=jdbc:oracle:thin:@//host.docker.internal:1521/FREEPDB1
PAYMENT_DB_SCHEMA=PAY
PAYMENT_DB_POOL_MAX=5
PAYMENT_DB_POOL_MIN=1
PAYMENT_JPA_OPEN_IN_VIEW=false
PAYMENT_JPA_TIME_ZONE=UTC

# mongodb e redis (externos ao cluster)
MONGODB_URI=mongodb://host.docker.internal:27017/payment
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_CONNECT_TIMEOUT=200ms
REDIS_TIMEOUT=300ms
REDIS_POOL_MAX_ACTIVE=16
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=0
REDIS_POOL_MAX_WAIT=100ms
PAYMENT_REDIS_HEALTH_ENABLED=false

# cache (otimizacao: indisponivel degrada, nao derruba)
PAYMENT_CACHE_ENABLED=true
PAYMENT_CACHE_KEY_PREFIX=payment
PAYMENT_CACHE_DEFAULT_TTL=10m
PAYMENT_CACHE_NULL_VALUES=true
PAYMENT_CACHE_CIRCUIT_FAILURES=3
PAYMENT_CACHE_CIRCUIT_COOLDOWN=30s

# bulkhead por dominio
PAYMENT_BULKHEAD_PROVIDER_CALLS=16
PAYMENT_BULKHEAD_PROVIDER_WAIT=50ms
PAYMENT_BULKHEAD_INVOICE_CALLS=6
PAYMENT_BULKHEAD_INVOICE_WAIT=0ms

# circuito: criacao de cobranca
PAYMENT_CB_CHARGE_CREATE_WINDOW=COUNT_BASED
PAYMENT_CB_CHARGE_CREATE_WINDOW_SIZE=20
PAYMENT_CB_CHARGE_CREATE_MIN_CALLS=10
PAYMENT_CB_CHARGE_CREATE_FAILURE_RATE=50
PAYMENT_CB_CHARGE_CREATE_OPEN_WAIT=30s
PAYMENT_CB_CHARGE_CREATE_SLOW_CALL=15s
PAYMENT_CB_CHARGE_CREATE_FAILURES=TOO_MANY_REQUESTS,SERVER_ERROR
PAYMENT_CB_CHARGE_CREATE_CONNECTION_FAILURES=true

# circuito: consulta de cobranca
PAYMENT_CB_CHARGE_QUERY_WINDOW=TIME_BASED
PAYMENT_CB_CHARGE_QUERY_WINDOW_SIZE=60
PAYMENT_CB_CHARGE_QUERY_MIN_CALLS=20
PAYMENT_CB_CHARGE_QUERY_FAILURE_RATE=60
PAYMENT_CB_CHARGE_QUERY_OPEN_WAIT=15s
PAYMENT_CB_CHARGE_QUERY_SLOW_CALL=10s
PAYMENT_CB_CHARGE_QUERY_FAILURES=TOO_MANY_REQUESTS,SERVER_ERROR
PAYMENT_CB_CHARGE_QUERY_CONNECTION_FAILURES=true

# circuito: emissao de nota
PAYMENT_CB_INVOICE_ISSUE_WINDOW=COUNT_BASED
PAYMENT_CB_INVOICE_ISSUE_WINDOW_SIZE=10
PAYMENT_CB_INVOICE_ISSUE_MIN_CALLS=5
PAYMENT_CB_INVOICE_ISSUE_FAILURE_RATE=50
PAYMENT_CB_INVOICE_ISSUE_OPEN_WAIT=60s
PAYMENT_CB_INVOICE_ISSUE_SLOW_CALL=30s
PAYMENT_CB_INVOICE_ISSUE_FAILURES=TOO_MANY_REQUESTS,SERVER_ERROR
PAYMENT_CB_INVOICE_ISSUE_CONNECTION_FAILURES=true

# retry (apenas operacao idempotente)
PAYMENT_RETRY_CHARGE_QUERY_ATTEMPTS=4
PAYMENT_RETRY_CHARGE_QUERY_INITIAL=200ms
PAYMENT_RETRY_CHARGE_QUERY_MULTIPLIER=2.0
PAYMENT_RETRY_CHARGE_QUERY_MAX=2s
PAYMENT_RETRY_CHARGE_QUERY_JITTER=0.3
PAYMENT_RETRY_CHARGE_REFUND_ATTEMPTS=3
PAYMENT_RETRY_CHARGE_REFUND_INITIAL=500ms
PAYMENT_RETRY_CHARGE_REFUND_MULTIPLIER=2.0
PAYMENT_RETRY_CHARGE_REFUND_MAX=4s
PAYMENT_RETRY_CHARGE_REFUND_JITTER=0.3
PAYMENT_RETRY_CHARGE_CANCEL_ATTEMPTS=3
PAYMENT_RETRY_CHARGE_CANCEL_INITIAL=500ms
PAYMENT_RETRY_CHARGE_CANCEL_MULTIPLIER=2.0
PAYMENT_RETRY_CHARGE_CANCEL_MAX=4s
PAYMENT_RETRY_CHARGE_CANCEL_JITTER=0.3
PAYMENT_RETRY_INVOICE_QUERY_ATTEMPTS=5
PAYMENT_RETRY_INVOICE_QUERY_INITIAL=1s
PAYMENT_RETRY_INVOICE_QUERY_MULTIPLIER=2.0
PAYMENT_RETRY_INVOICE_QUERY_MAX=20s
PAYMENT_RETRY_INVOICE_QUERY_JITTER=0.5
