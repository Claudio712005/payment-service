<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="APP_NAME"
                    source="spring.application.name" defaultValue="payment-service"/>
    <springProperty scope="context" name="LOG_CHARSET"
                    source="observability.logging.charset" defaultValue="UTF-8"/>
    <springProperty scope="context" name="LOG_CONSOLE_APPENDER"
                    source="observability.logging.console-appender" defaultValue="CONSOLE_JSON"/>
    <springProperty scope="context" name="LOG_ROOT_APPENDER"
                    source="observability.logging.root-appender" defaultValue="ASYNC"/>
    <springProperty scope="context" name="LOG_ROOT_LEVEL"
                    source="observability.logging.root-level" defaultValue="INFO"/>
    <springProperty scope="context" name="LOG_ASYNC_QUEUE_SIZE"
                    source="observability.logging.async.queue-size" defaultValue="8192"/>
    <springProperty scope="context" name="LOG_ASYNC_NEVER_BLOCK"
                    source="observability.logging.async.never-block" defaultValue="true"/>
    <springProperty scope="context" name="LOG_ASYNC_DISCARDING_THRESHOLD"
                    source="observability.logging.async.discarding-threshold" defaultValue="0"/>
    <springProperty scope="context" name="LOG_PLAIN_PATTERN"
                    source="observability.logging.plain-pattern"
                    defaultValue="%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [${APP_NAME},%X{traceId:-},%X{spanId:-},%X{requestId:-},%X{correlationId:-}] %-40.40logger{39} : %m%n%wEx"/>

    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
            <format>com.clau.payment_service.observability.logging.StructuredJsonLogFormatter</format>
            <charset>${LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <appender name="CONSOLE_PLAIN" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PLAIN_PATTERN}</pattern>
            <charset>${LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="${LOG_CONSOLE_APPENDER}"/>
        <queueSize>${LOG_ASYNC_QUEUE_SIZE}</queueSize>
        <discardingThreshold>${LOG_ASYNC_DISCARDING_THRESHOLD}</discardingThreshold>
        <neverBlock>${LOG_ASYNC_NEVER_BLOCK}</neverBlock>
        <includeCallerData>false</includeCallerData>
    </appender>

    <root level="${LOG_ROOT_LEVEL}">
        <appender-ref ref="${LOG_ROOT_APPENDER}"/>
    </root>

</configuration>
